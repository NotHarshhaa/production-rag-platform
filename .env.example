# --- Application ---------------------------------------------------------
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins ("*" allows all).
CORS_ORIGINS=*

# --- Storage -------------------------------------------------------------
# PostgreSQL in production; SQLite keeps local development dependency-free.
DATABASE_URL=sqlite:///./data/rag.db

# --- Vector store --------------------------------------------------------
# local (file-backed, survives restarts), inmemory (tests), qdrant (production,
# see compose.yaml).
VECTOR_STORE=local
VECTOR_STORE_PATH=./data/vectors.json
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks

# --- Embeddings ----------------------------------------------------------
# hashing (dependency-free, deterministic) | sentence-transformers | openai
# For sentence-transformers run: pip install -e ".[embeddings-local]"
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=
# Vector dimension. Used by the hashing provider; other providers infer it.
EMBEDDING_DIMENSION=384

# --- Chunking ------------------------------------------------------------
# Character-based chunk size and overlap.
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval -----------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20
# Combine BM25 keyword search with vector search (reciprocal rank fusion).
HYBRID_RETRIEVAL=true
# Minimum semantic similarity to consider context relevant (semantic mode).
MIN_RELEVANCE_SCORE=0.0

# --- Reranking -----------------------------------------------------------
# Requires: pip install -e ".[embeddings-local]"
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- LLM -----------------------------------------------------------------
# stub (deterministic extractive, no API needed) | openai (any compatible API)
LLM_PROVIDER=stub
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Point at any OpenAI-compatible endpoint (OpenAI, vLLM, Ollama, LM Studio...).
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Uploads -------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,txt,md

# --- Observability -------------------------------------------------------
LOG_LEVEL=INFO
# Emit JSON logs (recommended in production).
LOG_JSON=false
METRICS_ENABLED=true
# Optional OpenTelemetry tracing: pip install -e ".[otel]"
OTEL_ENABLED=false
OTEL_ENDPOINT=

# --- Rate limiting -------------------------------------------------------
# Requests per minute per client IP. 0 disables the limiter.
RATE_LIMIT_PER_MINUTE=0
